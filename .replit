modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 18115
externalPort = 3001

[[ports]]
localPort = 20578
externalPort = 6800

[[ports]]
localPort = 23919
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
API_ACCESS_TOKEN = "b282010fc09dc12327701cebb7f7ffea627f78a8b3b86041"
VITE_API_ACCESS_TOKEN = "b282010fc09dc12327701cebb7f7ffea627f78a8b3b86041"
EXPO_PUBLIC_API_ACCESS_TOKEN = "b282010fc09dc12327701cebb7f7ffea627f78a8b3b86041"
