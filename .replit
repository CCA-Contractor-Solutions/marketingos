modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 18115
externalPort = 3001

[[ports]]
localPort = 20578
externalPort = 6800

[[ports]]
localPort = 23919
externalPort = 3000

[nix]
channel = "stable-25_05"

[userenv]

# API access tokens are NOT stored here. The previous committed values were
# rotated and moved to the deploy environment's secret store (Replit Secrets):
#   API_ACCESS_TOKEN, VITE_API_ACCESS_TOKEN, EXPO_PUBLIC_API_ACCESS_TOKEN
# Set them there so they are never committed to source control.
# See docs/source-of-truth.md (Security notes).
